<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="patients_report" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">

    <field name="patientId" class="java.lang.String"/>
    <field name="name" class="java.lang.String"/>
    <field name="contactNo" class="java.lang.String"/>
    <field name="nic" class="java.lang.String"/>
    <field name="dateOfBirth" class="java.lang.String"/>
    <field name="age" class="java.lang.Integer"/>
    <field name="gender" class="java.lang.String"/>
    <field name="registeredDate" class="java.lang.String"/>

    <title>
        <band height="60">
            <staticText>
                <reportElement x="0" y="0" width="535" height="26"/>
                <textElement textAlignment="Center">
                    <font size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[Sunrise Dental Clinic - Patient List]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="30" width="535" height="1"/>
            </line>
        </band>
    </title>

    <columnHeader>
        <band height="20">
            <staticText>
                <reportElement x="0" y="0" width="60" height="20" forecolor="#FFFFFF" backcolor="#2F44B0" mode="Opaque"/>
                <textElement><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Patient Id]]></text>
            </staticText>
            <staticText>
                <reportElement x="60" y="0" width="100" height="20" forecolor="#FFFFFF" backcolor="#2F44B0" mode="Opaque"/>
                <textElement><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Name]]></text>
            </staticText>
            <staticText>
                <reportElement x="160" y="0" width="75" height="20" forecolor="#FFFFFF" backcolor="#2F44B0" mode="Opaque"/>
                <textElement><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Contact]]></text>
            </staticText>
            <staticText>
                <reportElement x="235" y="0" width="75" height="20" forecolor="#FFFFFF" backcolor="#2F44B0" mode="Opaque"/>
                <textElement><font size="9" isBold="true"/></textElement>
                <text><![CDATA[NIC]]></text>
            </staticText>
            <staticText>
                <reportElement x="310" y="0" width="65" height="20" forecolor="#FFFFFF" backcolor="#2F44B0" mode="Opaque"/>
                <textElement><font size="9" isBold="true"/></textElement>
                <text><![CDATA[DOB]]></text>
            </staticText>
            <staticText>
                <reportElement x="375" y="0" width="30" height="20" forecolor="#FFFFFF" backcolor="#2F44B0" mode="Opaque"/>
                <textElement textAlignment="Center"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Age]]></text>
            </staticText>
            <staticText>
                <reportElement x="405" y="0" width="55" height="20" forecolor="#FFFFFF" backcolor="#2F44B0" mode="Opaque"/>
                <textElement><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Gender]]></text>
            </staticText>
            <staticText>
                <reportElement x="460" y="0" width="75" height="20" forecolor="#FFFFFF" backcolor="#2F44B0" mode="Opaque"/>
                <textElement><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Registered]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="18" splitType="Stretch">
            <textField>
                <reportElement x="0" y="0" width="60" height="18"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{patientId}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="60" y="0" width="100" height="18"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{name}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="160" y="0" width="75" height="18"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{contactNo}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="235" y="0" width="75" height="18"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{nic}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="310" y="0" width="65" height="18"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{dateOfBirth}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="375" y="0" width="30" height="18"/>
                <textElement textAlignment="Center"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{age}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="405" y="0" width="55" height="18"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{gender}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="460" y="0" width="75" height="18"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{registeredDate}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <summary>
        <band height="30">
            <textField evaluationTime="Report">
                <reportElement x="0" y="6" width="535" height="16"/>
                <textElement textAlignment="Right"><font size="9" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA["Total patients: " + $V{REPORT_COUNT}]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>
