<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="appointments_report" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">

    <parameter name="scopeLabel" class="java.lang.String"/>

    <field name="appointmentNo" class="java.lang.String"/>
    <field name="patientName" class="java.lang.String"/>
    <field name="dentistName" class="java.lang.String"/>
    <field name="appointmentDate" class="java.lang.String"/>
    <field name="appointmentTime" class="java.lang.String"/>
    <field name="treatment" class="java.lang.String"/>
    <field name="noTooth" class="java.lang.Integer"/>
    <field name="status" class="java.lang.String"/>

    <title>
        <band height="60">
            <staticText>
                <reportElement x="0" y="0" width="535" height="26"/>
                <textElement textAlignment="Center">
                    <font size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[Sunrise Dental Clinic - Appointment Schedule]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="28" width="535" height="16"/>
                <textElement textAlignment="Center">
                    <font size="10" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{scopeLabel}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="46" width="535" height="1"/>
            </line>
        </band>
    </title>

    <columnHeader>
        <band height="20">
            <staticText>
                <reportElement x="0" y="0" width="70" height="20" forecolor="#FFFFFF" backcolor="#2F44B0" mode="Opaque"/>
                <textElement><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Apt No]]></text>
            </staticText>
            <staticText>
                <reportElement x="70" y="0" width="100" height="20" forecolor="#FFFFFF" backcolor="#2F44B0" mode="Opaque"/>
                <textElement><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Patient]]></text>
            </staticText>
            <staticText>
                <reportElement x="170" y="0" width="100" height="20" forecolor="#FFFFFF" backcolor="#2F44B0" mode="Opaque"/>
                <textElement><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Dentist]]></text>
            </staticText>
            <staticText>
                <reportElement x="270" y="0" width="65" height="20" forecolor="#FFFFFF" backcolor="#2F44B0" mode="Opaque"/>
                <textElement><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Date]]></text>
            </staticText>
            <staticText>
                <reportElement x="335" y="0" width="50" height="20" forecolor="#FFFFFF" backcolor="#2F44B0" mode="Opaque"/>
                <textElement><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Time]]></text>
            </staticText>
            <staticText>
                <reportElement x="385" y="0" width="80" height="20" forecolor="#FFFFFF" backcolor="#2F44B0" mode="Opaque"/>
                <textElement><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Treatment]]></text>
            </staticText>
            <staticText>
                <reportElement x="465" y="0" width="30" height="20" forecolor="#FFFFFF" backcolor="#2F44B0" mode="Opaque"/>
                <textElement textAlignment="Center"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[No.]]></text>
            </staticText>
            <staticText>
                <reportElement x="495" y="0" width="40" height="20" forecolor="#FFFFFF" backcolor="#2F44B0" mode="Opaque"/>
                <textElement><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Status]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="18" splitType="Stretch">
            <textField>
                <reportElement x="0" y="0" width="70" height="18"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{appointmentNo}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="70" y="0" width="100" height="18"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{patientName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="170" y="0" width="100" height="18"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{dentistName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="270" y="0" width="65" height="18"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{appointmentDate}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="335" y="0" width="50" height="18"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{appointmentTime}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="385" y="0" width="80" height="18"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{treatment}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="465" y="0" width="30" height="18"/>
                <textElement textAlignment="Center"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{noTooth}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="495" y="0" width="40" height="18"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <summary>
        <band height="30">
            <textField evaluationTime="Report">
                <reportElement x="0" y="6" width="535" height="16"/>
                <textElement textAlignment="Right"><font size="9" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA["Total appointments: " + $V{REPORT_COUNT}]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>
