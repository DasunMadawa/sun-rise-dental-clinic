<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="bill_report" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">

    <parameter name="paymentId" class="java.lang.String"/>
    <parameter name="appointmentNo" class="java.lang.String"/>
    <parameter name="paymentDate" class="java.lang.String"/>
    <parameter name="patientId" class="java.lang.String"/>
    <parameter name="patientName" class="java.lang.String"/>
    <parameter name="dentistName" class="java.lang.String"/>
    <parameter name="treatmentName" class="java.lang.String"/>
    <parameter name="noTooth" class="java.lang.Integer"/>
    <parameter name="consultationFee" class="java.lang.Double"/>
    <parameter name="treatmentCost" class="java.lang.Double"/>
    <parameter name="discount" class="java.lang.Double"/>
    <parameter name="total" class="java.lang.Double"/>
    <parameter name="paymentMethod" class="java.lang.String"/>

    <title>
        <band height="90">
            <staticText>
                <reportElement x="0" y="0" width="535" height="30"/>
                <textElement textAlignment="Center">
                    <font size="20" isBold="true"/>
                </textElement>
                <text><![CDATA[SUNRISE DENTAL CLINIC]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="30" width="535" height="16"/>
                <textElement textAlignment="Center">
                    <font size="10" isItalic="true"/>
                </textElement>
                <text><![CDATA[Appointment and Patient Management System]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="55" width="535" height="1"/>
            </line>
            <staticText>
                <reportElement x="0" y="62" width="535" height="20"/>
                <textElement textAlignment="Center">
                    <font size="14" isBold="true"/>
                </textElement>
                <text><![CDATA[PAYMENT RECEIPT]]></text>
            </staticText>
        </band>
    </title>

    <detail>
        <band height="260">
            <staticText>
                <reportElement x="0" y="0" width="140" height="18"/>
                <text><![CDATA[Payment No]]></text>
            </staticText>
            <textField>
                <reportElement x="140" y="0" width="180" height="18"/>
                <textFieldExpression><![CDATA[$P{paymentId}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="330" y="0" width="100" height="18"/>
                <text><![CDATA[Date]]></text>
            </staticText>
            <textField>
                <reportElement x="430" y="0" width="105" height="18"/>
                <textFieldExpression><![CDATA[$P{paymentDate}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="20" width="140" height="18"/>
                <text><![CDATA[Appointment No]]></text>
            </staticText>
            <textField>
                <reportElement x="140" y="20" width="180" height="18"/>
                <textFieldExpression><![CDATA[$P{appointmentNo}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="40" width="140" height="18"/>
                <text><![CDATA[Patient]]></text>
            </staticText>
            <textField>
                <reportElement x="140" y="40" width="395" height="18"/>
                <textFieldExpression><![CDATA[$P{patientName} + " (" + $P{patientId} + ")"]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="60" width="140" height="18"/>
                <text><![CDATA[Dentist]]></text>
            </staticText>
            <textField>
                <reportElement x="140" y="60" width="395" height="18"/>
                <textFieldExpression><![CDATA[$P{dentistName}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="80" width="140" height="18"/>
                <text><![CDATA[Treatment]]></text>
            </staticText>
            <textField>
                <reportElement x="140" y="80" width="395" height="18"/>
                <textFieldExpression><![CDATA[$P{treatmentName} + " x " + $P{noTooth}]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="0" y="108" width="535" height="1"/>
            </line>

            <staticText>
                <reportElement x="0" y="116" width="300" height="18"/>
                <text><![CDATA[Consultation Fee]]></text>
            </staticText>
            <textField pattern="'Rs.' #,##0.00">
                <reportElement x="300" y="116" width="235" height="18"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$P{consultationFee}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="136" width="300" height="18"/>
                <text><![CDATA[Treatment Cost]]></text>
            </staticText>
            <textField pattern="'Rs.' #,##0.00">
                <reportElement x="300" y="136" width="235" height="18"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$P{treatmentCost}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="156" width="300" height="18"/>
                <text><![CDATA[Discount]]></text>
            </staticText>
            <textField pattern="'Rs.' #,##0.00">
                <reportElement x="300" y="156" width="235" height="18"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$P{discount}]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="0" y="182" width="535" height="1"/>
            </line>

            <staticText>
                <reportElement x="0" y="188" width="300" height="24"/>
                <textElement>
                    <font size="14" isBold="true"/>
                </textElement>
                <text><![CDATA[TOTAL]]></text>
            </staticText>
            <textField pattern="'Rs.' #,##0.00">
                <reportElement x="300" y="188" width="235" height="24"/>
                <textElement textAlignment="Right">
                    <font size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{total}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="222" width="140" height="18"/>
                <text><![CDATA[Payment Method]]></text>
            </staticText>
            <textField>
                <reportElement x="140" y="222" width="200" height="18"/>
                <textFieldExpression><![CDATA[$P{paymentMethod}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="240" width="535" height="16"/>
                <textElement textAlignment="Center">
                    <font size="9" isItalic="true"/>
                </textElement>
                <text><![CDATA[Thank you for visiting Sunrise Dental Clinic.]]></text>
            </staticText>
        </band>
    </detail>

</jasperReport>
